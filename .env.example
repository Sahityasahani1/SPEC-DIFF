# ==============================================================================
# SpecDiff Platform Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN REAL SECRETS (NEVER COMMIT .env TO GIT)
# ==============================================================================

# Target Environment: development | staging | production | test
ENVIRONMENT=development

# Database Connection (SQLite for local dev, PostgreSQL for production)
# Local SQLite Dev: sqlite:///./smartpick.db
# PostgreSQL Prod: postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
DATABASE_URL=sqlite:///./smartpick.db
POSTGRES_PASSWORD=replace_with_strong_db_password_min_32_chars

# Distributed Redis In-Memory Cache (Optional, in-memory fallback will activate if offline)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Security & Admin RBAC Configuration
# MUST be rotated and set to a high-entropy string (>=32 chars) in production!
ADMIN_API_KEY=replace_with_strong_random_secret_token_min_32_chars

# CORS Allowed Origins (Comma-delimited explicit allowlist)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting Policies
RATE_LIMIT_RECOMMEND=15/minute
RATE_LIMIT_COPILOT=20/minute

# External AI API Keys (Optional: Leave blank to use local Qwen model / offline deterministic engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
USE_LOCAL_LLM=true

# Real-Time Market Price Intelligence APIs (Optional: Keep blank to use hybrid live scraper & engine)
KEEPA_API_KEY=
RAINFOREST_API_KEY=

