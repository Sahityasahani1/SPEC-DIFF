# ==============================================================================
# SpecDiff / SmartPick Platform Production Environment Configuration
# ==============================================================================

# PostgreSQL Connection Strings
# Docker Compose Internal: postgresql+asyncpg://postgres:postgres@db:5432/specdiff
# Local Machine Dev: postgresql+asyncpg://postgres:postgres@localhost:5432/specdiff
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/specdiff
POSTGRES_PASSWORD=postgres

# Distributed Redis In-Memory Cache
# Docker Compose Internal: redis://redis:6379/0
# Local Machine Dev: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# Security & RBAC Configuration
ADMIN_API_KEY=specdiff_admin_secret_key_2026
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1

# Rate Limiting
RATE_LIMIT_RECOMMEND=15/minute

# Optional Gemini Generative AI Key (Leave blank to use deterministic rule fallback)
GEMINI_API_KEY=
